# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Firebase (used via String.fromEnvironment in firebase_options.dart)
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID=1:123456789:android:your-app-id
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_IOS_BUNDLE_ID=com.miro.familyhub

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_...

# OpenWeather
OPENWEATHER_API_KEY=your-openweather-api-key

# Aile Zekâsı (Gemini) — DİKKAT: GEMINI_API_KEY artık CLIENT'a KONULMAMALI.
# Güvenli yol: Supabase secret olarak ayarla, family-ai Edge Function kullanır:
#   supabase secrets set GEMINI_API_KEY=...
# (Aşağıdaki client dart-define YALNIZCA eski doğrudan-çağrı içindir; geçit
#  deploy edilince kaldırılacak.)
# GEMINI_API_KEY=
